# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Browser key: restrict by HTTP referrer, enable Maps JavaScript, Places, Directions.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-maps-key
# Server key: restrict by IP, used for Routes/Distance Matrix from API routes.
GOOGLE_MAPS_SERVER_API_KEY=your-server-maps-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# ─── Stripe ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Notifications ───────────────────────────────────────────────────────────
# Twilio (SMS) — also configure in Supabase Auth for phone OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Resend (email)
RESEND_API_KEY=
# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
